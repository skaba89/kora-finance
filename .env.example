# Modèle de configuration locale. `make env` copie ce fichier vers .env en remplaçant
# chaque __GENERATE__ par un secret aléatoire. Ne jamais committer .env.

# --- PostgreSQL (super-utilisateur réservé à l'initialisation du conteneur)
KORA_POSTGRES_ADMIN_PASSWORD=__GENERATE__
# Rôle propriétaire du schéma (migrations Alembic)
KORA_DB_OWNER_PASSWORD=__GENERATE__
# Rôle d'exécution de l'API et du worker (NOBYPASSRLS, sans DDL)
KORA_DB_APP_PASSWORD=__GENERATE__

# --- Ports publiés sur 127.0.0.1 uniquement
KORA_API_PORT=8100
KORA_WEB_PORT=3100
KORA_POSTGRES_PORT=55432
KORA_REDIS_PORT=56379
# Interface web de Mailpit (emails capturés en local)
KORA_MAILPIT_PORT=58025

KORA_LOG_LEVEL=INFO

# --- Authentification et chiffrement
# Clé HMAC des JWT (64 caractères hexadécimaux minimum)
KORA_JWT_SECRET=__GENERATE__
# Clé(s) Fernet de chiffrement au repos ; la première chiffre, toutes déchiffrent
KORA_ENCRYPTION_KEYS=__GENERATE_FERNET__
