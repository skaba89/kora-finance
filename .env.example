# Modèle de configuration locale. `make env` copie ce fichier vers .env en remplaçant
# chaque __GENERATE__ par un secret aléatoire. Ne jamais committer .env.

# --- PostgreSQL (super-utilisateur réservé à l'initialisation du conteneur)
KORA_POSTGRES_ADMIN_PASSWORD=__GENERATE__
# Rôle propriétaire du schéma (migrations Alembic)
KORA_DB_OWNER_PASSWORD=__GENERATE__
# Rôle d'exécution de l'API et du worker (NOBYPASSRLS, sans DDL)
KORA_DB_APP_PASSWORD=__GENERATE__

# --- Ports publiés sur 127.0.0.1 uniquement
KORA_API_PORT=8100
KORA_WEB_PORT=3100
KORA_POSTGRES_PORT=55432
KORA_REDIS_PORT=56379
# Interface web de Mailpit (emails capturés en local)
KORA_MAILPIT_PORT=58025
# API S3 de Garage (stockage local des pièces justificatives)
KORA_S3_PORT=53900

KORA_LOG_LEVEL=INFO

# --- Authentification et chiffrement
# Clé HMAC des JWT (64 caractères hexadécimaux minimum)
KORA_JWT_SECRET=__GENERATE__
# Clé(s) Fernet de chiffrement au repos ; la première chiffre, toutes déchiffrent
KORA_ENCRYPTION_KEYS=__GENERATE_FERNET__

# --- Stockage S3 local (Garage). En production : bucket et clés du fournisseur S3.
# Secret de cluster et jeton d'administration de Garage (local uniquement)
KORA_GARAGE_RPC_SECRET=__GENERATE__
KORA_GARAGE_ADMIN_TOKEN=__GENERATE__
# Clé d'accès S3 de l'API (identifiant au format Garage : GK + 24 caractères hexadécimaux)
KORA_S3_ACCESS_KEY_ID=__GENERATE_GARAGE_KEY_ID__
KORA_S3_SECRET_ACCESS_KEY=__GENERATE__
# --- Sauvegardes (KF-09) : bucket et clé DÉDIÉS, distincts du stockage des pièces.
# La clé de sauvegarde ne porte aucun droit de suppression (rétention côté fournisseur) ;
# la clé d'administration de la purge (KORA_BACKUP_ADMIN_S3_*) ne se déploie jamais ici.
KORA_BACKUP_S3_ACCESS_KEY_ID=__GENERATE_GARAGE_KEY_ID__
KORA_BACKUP_S3_SECRET_ACCESS_KEY=__GENERATE__
