# Configuration de production de Kora (deploy/vps/.env, créé par ./init-env.sh).
# Ne jamais committer le fichier .env. Conserver une copie des secrets marqués (*) dans
# un gestionnaire de mots de passe, HORS du serveur : sans KORA_ENCRYPTION_KEYS, les
# pièces justificatives et les sauvegardes sont illisibles.

# --- Mode de publication (une seule des deux lignes) :
#  serveur dédié à Kora : son propre Caddy tient les ports 80/443
COMPOSE_PROFILES=caddy
#  serveur partagé : un proxy déjà en place publie Kora (voir compose.proxy-externe.yml)
# COMPOSE_FILE=compose.yml:compose.proxy-externe.yml

# --- Adresse publique (sans https://). Sans nom de domaine : <ip-avec-tirets>.sslip.io,
# ex. 51-75-1-2.sslip.io pour 51.75.1.2 ; sur un serveur partagé, préfixer pour ne pas
# reprendre le nom d'un autre site (ex. kora.51-75-1-2.sslip.io).
KORA_DOMAIN=__A_REMPLIR__
# Email de contact pour Let's Encrypt (alertes d'expiration de certificat) ; inutile en
# mode proxy existant (mettre « - »).
KORA_ACME_EMAIL=__A_REMPLIR__

# --- Secrets générés (*)
KORA_POSTGRES_ADMIN_PASSWORD=__GENERATE__
KORA_DB_OWNER_PASSWORD=__GENERATE__
KORA_DB_APP_PASSWORD=__GENERATE__
KORA_JWT_SECRET=__GENERATE__
KORA_ENCRYPTION_KEYS=__GENERATE_FERNET__
# Plafonds de session PostgreSQL (N-B6) : requêtes et attentes de verrous bornées.
KORA_STATEMENT_TIMEOUT_MS=60000
KORA_LOCK_TIMEOUT_MS=5000

# --- Stockage S3 (Backblaze B2 : endpoint du bucket, clé limitée au bucket) (*)
# Pièces justificatives : clé limitée au bucket des pièces, sans aucun accès aux
# sauvegardes (KF-09).
KORA_S3_ENDPOINT_URL=__A_REMPLIR__
KORA_S3_REGION=__A_REMPLIR__
KORA_S3_BUCKET=__A_REMPLIR__
KORA_S3_ACCESS_KEY_ID=__A_REMPLIR__
KORA_S3_SECRET_ACCESS_KEY=__A_REMPLIR__

# --- Sauvegardes (KF-09) : bucket et clé DÉDIÉS, distincts du stockage des pièces (*).
# La clé de sauvegarde ne doit porter AUCUN droit de suppression (B2 : capabilities
# sans deleteFiles ; S3 : politique refusant DeleteObject) : la rétention est administrée
# côté fournisseur (cycle de vie, Object Lock), jamais par l'application. Ces variables
# ne sont transmises qu'au service « backup » (jamais à l'API, au worker ou au web).
KORA_BACKUP_S3_ENDPOINT_URL=__A_REMPLIR__
KORA_BACKUP_S3_REGION=__A_REMPLIR__
KORA_BACKUP_S3_BUCKET=__A_REMPLIR__
KORA_BACKUP_S3_ACCESS_KEY_ID=__A_REMPLIR__
KORA_BACKUP_S3_SECRET_ACCESS_KEY=__A_REMPLIR__
# Clé d'administration de la purge manuelle (`python -m kora.scripts.backup prune`),
# DISTINCTE de la clé de sauvegarde : à conserver hors du serveur (gestionnaire de
# secrets), ne jamais la placer dans ce fichier ni sur le VPS.
# KORA_BACKUP_ADMIN_S3_ACCESS_KEY_ID=
# KORA_BACKUP_ADMIN_S3_SECRET_ACCESS_KEY=

# --- Emails : « disabled » tant qu'aucun fournisseur n'est choisi ; ensuite « smtp ».
KORA_EMAIL_BACKEND=disabled
# KORA_EMAIL_FROM=Kora Finance <no-reply@mondomaine.gn>
# KORA_SMTP_HOST=smtp-relay.exemple.com
# KORA_SMTP_PORT=587
# KORA_SMTP_SECURITY=starttls
# KORA_SMTP_USERNAME=
# KORA_SMTP_PASSWORD=

# --- Alertes d'exploitation (KF-12) : destinataire des échecs de sauvegarde, du
# contrôle de fraîcheur et de la sonde externe (unités systemd kora-* + alert.sh).
# Requis pour recevoir les alertes ; sans lui, elles restent journalisées
# (backups/alertes/journal.log). Avec KORA_EMAIL_BACKEND=smtp, un fournisseur
# d'envoi doit aussi être configuré ci-dessus.
KORA_ALERT_EMAIL=__A_REMPLIR__

# --- Quotas d'exports (KF-13) : les valeurs par défaut du Compose conviennent à un
# VPS modeste ; à surcharger uniquement si les besoins réels le justifient.
# KORA_EXPORTS_PER_USER_PER_HOUR=30
# KORA_EXPORTS_PER_COMPANY_PER_HOUR=120

# Administration plateforme réservée aux comptes avec 2FA (voir docs/DEPLOIEMENT.md §6 bis).
# Activer seulement après avoir vérifié la 2FA de chaque administrateur.
KORA_PLATFORM_ADMIN_REQUIRE_MFA=false

# Pool PostgreSQL de l'API par processus (docs/TESTS_CHARGE.md) et seuil du journal
# des requêtes lentes. API + worker + planificateur restent sous max_connections (100).
KORA_DB_POOL_SIZE=10
KORA_DB_MAX_OVERFLOW=20
KORA_SLOW_REQUEST_MS=1000
