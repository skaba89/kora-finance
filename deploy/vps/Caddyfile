# Point d'entrée public : HTTPS automatique (Let's Encrypt), puis le serveur web Next.js.
# L'API n'est jamais exposée, sauf ses sondes de santé (KF-12) : /health/live et
# /health/ready ne renvoient qu'un statut ok|erreur des dépendances, sans donnée
# métier — la sonde externe probe.sh les interroge depuis l'hôte (certificat TLS inclus).
{
	email {$KORA_ACME_EMAIL}
}

{$KORA_DOMAIN} {
	encode zstd gzip
	# Pièces justificatives : 10 Mo au plus côté API, un peu de marge pour l'enveloppe.
	request_body {
		max_size 12MB
	}
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	handle /health/* {
		reverse_proxy api:8000
	}
	reverse_proxy web:3000
}
